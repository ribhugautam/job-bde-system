# Copy to .env and fill in. Keys and comments only — never commit real values.
#
# THIS FILE IS SECRETS ONLY.
#
# It used to hold 35 variables. Twenty of them were operational tuning — match
# threshold, source toggles, follow-up cadence, worker limits — and changing one
# meant editing Vercel and redeploying, which is slow enough that nothing ever
# got tuned. Worse, their bulk buried the values that genuinely are secret.
#
# Those twenty now live in the database and are edited by an admin at
# /dashboard/settings. `npm run db:migrate` seeds them from whatever you
# currently have set, so nothing changes behaviour when you deploy this. After
# that they are IGNORED here — the settings page lists any that are still set,
# so you can go and delete them.
#
# The test for whether something belongs in this file:
#   1. Would leaking it be harmful?                       -> here
#   2. Is it read before a database connection exists?    -> here
#   3. Is it inlined at build time by Next?               -> here
# Anything else is a setting.
#
# Every variable here is parsed and validated by lib/config/env.ts, which is the
# only place in the codebase that reads process.env. A bad value fails loudly at
# startup with a message naming the key, rather than surfacing as a strange
# error hours later inside a cron run.

# =============================================================================
# Database — Turso (libSQL / SQLite)
# =============================================================================
# Leave BOTH unset for local development: the app falls back to a real SQLite
# file at ./local.db with nothing to install and no server to run.
#
# For production:
#   npm i -g turso
#   turso auth signup
#   turso db create job-bde-system
#   turso db show job-bde-system --url     -> TURSO_DATABASE_URL
#   turso db tokens create job-bde-system  -> TURSO_AUTH_TOKEN
#
# A remote URL with no token is rejected at startup — that combination
# otherwise fails later with an opaque libSQL error.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# =============================================================================
# Sender email
# =============================================================================
# Each person now stores their OWN mailbox at /dashboard/settings, encrypted at
# rest. These remain as the fallback the unattended pipeline sends from, and for
# a deployment where nobody has set one up yet.
#
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an App Password:   https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below, NOT your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where the daily digest is sent, and the address the FIRST ADMIN ACCOUNT is
# created under by `npm run db:migrate`. Defaults to GMAIL_USER when unset.
OWNER_EMAIL=

# =============================================================================
# Dashboard login  (required)
# =============================================================================
# Accounts are invite-only and live in the database. APP_PASSWORD is what the
# migration uses to create the FIRST admin — sign in with OWNER_EMAIL plus this,
# then invite everyone else from /dashboard/team.
#
# Minimum 8 characters, and make it RANDOM, not a word. The login route
# throttles at 10 attempts/minute per IP+email, but that counter lives in one
# warm serverless instance rather than globally, so it is a speed bump and not a
# real rate limiter. `openssl rand -base64 12` gives you something suitable.
APP_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing this immediately signs out every browser. Minimum 16 characters.
AUTH_SECRET=

# Encrypts each person's stored mailbox password. Generate with:
#   openssl rand -hex 32
#
# DELIBERATELY SEPARATE from AUTH_SECRET. Rotating AUTH_SECRET is meant to be
# cheap — it just signs everyone out. If it also encrypted credentials, the same
# rotation would silently destroy every stored mailbox password, and you would
# find out days later when applications stopped being sent.
#
# Without this, mailbox setup is refused and everything is drafted and queued
# for one-click sending instead. Nothing is ever stored in plaintext.
ENCRYPTION_KEY=

# =============================================================================
# Cron security  (required)
# =============================================================================
# /api/cron/daily is the ONLY route outside the password gate, so this is the
# only thing between the public internet and a real pipeline run. Use a long
# random value.
#
# It is accepted as a bearer header ONLY, never as a ?secret= query param —
# query strings are written to Vercel's request logs in plaintext. Trigger
# manually with:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<app>/api/cron/daily
CRON_SECRET=

# =============================================================================
# Safety switch
# =============================================================================
# Dry run is normally a toggle on the Settings page. This variable still exists
# as the DEPLOY-LEVEL stop, and it can only ever force dry-run ON — never off.
#
# Set it to 1 and nothing can send, whatever the dashboard says and whoever is
# signed in. That asymmetry is the point: the toggle gives day-to-day control,
# this is a stop that a compromised or mistaken admin account cannot undo.
#
# Leave it empty (or 0) to let the Settings toggle decide.
DRY_RUN=

# =============================================================================
# IMAP credentials — reading YOUR OWN inbox for job alerts, read-only
# =============================================================================
# Host, port and mailbox are ordinary settings and live on the Settings page.
# Only the credentials are here.
#
# Default to GMAIL_USER / GMAIL_APP_PASSWORD — the same 16-char app password
# works for IMAP, so there is usually nothing new to generate.
IMAP_USER=
IMAP_PASSWORD=

# =============================================================================
# Optional sources and providers
# =============================================================================
# Adzuna is skipped unless BOTH are set. Free key: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Enables AI-written cover letters instead of the built-in templates.
# Leave unset to use templates — the app works fine without it.
ANTHROPIC_API_KEY=

# Your deployed URL, used in the digest email's dashboard link and in invite
# links. Next inlines this at BUILD time, which is why it cannot be a runtime
# setting like the rest of the tuning knobs.
NEXT_PUBLIC_APP_URL=
