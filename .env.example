# Copy to .env and fill in. Keys and comments only — never commit real values.
# Every variable here is parsed and validated by lib/config/env.ts, which is the
# only place in the codebase that reads process.env. A bad value fails loudly at
# startup with a message naming the key, rather than surfacing as a strange
# error hours later inside a cron run.

# =============================================================================
# Database — Turso (libSQL / SQLite)
# =============================================================================
# Leave BOTH unset for local development: the app falls back to a real SQLite
# file at ./local.db with nothing to install and no server to run.
#
# For production:
#   npm i -g turso
#   turso auth signup
#   turso db create job-bde-system
#   turso db show job-bde-system --url     -> TURSO_DATABASE_URL
#   turso db tokens create job-bde-system  -> TURSO_AUTH_TOKEN
#
# A remote URL with no token is rejected at startup — that combination
# otherwise fails later with an opaque libSQL error.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# =============================================================================
# Sender email  (required to send applications, outreach, follow-ups, digests)
# =============================================================================
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate an App Password:   https://myaccount.google.com/apppasswords
# 3. Use that 16-character password below, NOT your normal Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where the daily digest is sent. Defaults to GMAIL_USER when unset.
OWNER_EMAIL=

# =============================================================================
# Dashboard login  (required)
# =============================================================================
# The whole deployment is private: every page and API route is gated behind
# this one password. Minimum 8 characters — the app serves 503 on every route,
# including /login, if it is missing or shorter, so it can never fall open.
#
# Make it RANDOM, not a word. The login route throttles at 10 attempts/minute
# per IP, but that counter lives in one warm serverless instance rather than
# globally, so it is a speed bump and not a real rate limiter. 8 random
# characters are far out of brute-force reach; an 8-letter dictionary word is
# not. `openssl rand -base64 12` gives you something suitable.
APP_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
# Changing this immediately signs out every browser. Minimum 16 characters.
AUTH_SECRET=

# =============================================================================
# Cron security  (required)
# =============================================================================
# /api/cron/daily is the ONLY route outside the password gate, so this is the
# only thing between the public internet and a real pipeline run. Use a long
# random value.
#
# It is accepted as a bearer header ONLY, never as a ?secret= query param —
# query strings are written to Vercel's request logs in plaintext. Trigger
# manually with:
#   curl -H "Authorization: Bearer $CRON_SECRET" https://<app>/api/cron/daily
CRON_SECRET=

# =============================================================================
# Safety switch
# =============================================================================
# DRY_RUN=1 fetches, scores and drafts everything into the dashboard but sends
# ZERO email — no applications, no outreach, no follow-ups, not even the digest.
# Leave this on until you have read a few generated drafts end to end.
# Set to 0 or delete the line to go live.
DRY_RUN=1

# =============================================================================
# Matching
# =============================================================================
# Fit score (0-100) a job must reach before it is drafted. Default 40.
# Note: the old SPARSE_MATCH_THRESHOLD is gone. It existed because LinkedIn
# alert emails carry no description and could only be scored on their title.
# The enrichment stage below now recovers descriptions, so LinkedIn jobs are
# scored on the same evidence as every other source and need no separate bar.
MATCH_THRESHOLD=40

# =============================================================================
# LinkedIn ingest — via YOUR OWN inbox, over IMAP, read-only
# =============================================================================
# This does not log in to LinkedIn. You create saved searches on LinkedIn and
# switch on EMAIL job alerts; those emails arrive in your own mailbox and are
# parsed there. The IMAP connection is read-only and never marks mail as read.
#
# Setup: LinkedIn -> run a job search -> toggle "Job alert" on -> Email, daily.
ENABLE_LINKEDIN_ALERTS=0

# Reads Wellfound "New jobs:" digests from your own inbox over IMAP, read-only.
# Needs IMAP_USER/IMAP_PASSWORD, or the existing GMAIL_USER/GMAIL_APP_PASSWORD.
ENABLE_WELLFOUND_ALERTS=0

# Reads Indeed job-alert digests the same way. High volume — Indeed's alerts
# skew toward agency postings, so expect the role veto to do real work.
ENABLE_INDEED_ALERTS=0

# Default to GMAIL_USER / GMAIL_APP_PASSWORD — the same 16-char app password
# works for IMAP, so there is nothing new to generate.
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# IMAP_MAILBOX=INBOX
# IMAP_USER=
# IMAP_PASSWORD=

# How many days of alert emails to scan per run.
# LINKEDIN_ALERT_DAYS=3

# =============================================================================
# LinkedIn enrichment — unauthenticated fetch of the public job page
# =============================================================================
# Alert emails contain no job description. This fetches the PUBLIC
# /jobs/view/{id} page with no login, no cookie and no session to recover it,
# so no account is involved and none can be restricted. Results are cached
# permanently per job id, including failures, so the request count tracks new
# alerts rather than the size of the backlog.
#
# If LinkedIn rate-limits or blocks the fetch the job simply stays title-only,
# which is exactly the behavior before this existed. Set to 0 to disable.
ENABLE_LINKEDIN_ENRICH=1
LINKEDIN_ENRICH_DAILY_CAP=80
LINKEDIN_ENRICH_DELAY_MS=1500

# =============================================================================
# Reply detection and follow-ups
# =============================================================================
# Replies are matched by RFC 5322 Message-ID (In-Reply-To / References against
# the id captured at send time) — an exact match, not a sender guess. A reply
# cancels any pending follow-up.
#
# With no reply: one nudge at FOLLOWUP_FIRST_DAYS, a final one at
# FOLLOWUP_FINAL_DAYS, then the sequence stops permanently. FINAL must be
# greater than FIRST or startup fails.
ENABLE_FOLLOWUPS=1
FOLLOWUP_FIRST_DAYS=4
FOLLOWUP_FINAL_DAYS=10
FOLLOWUP_DAILY_CAP=20

# =============================================================================
# Worker
# =============================================================================
# The pipeline is a resumable stage machine drained by a time-budgeted worker.
# When the budget runs out mid-run it stops cleanly and the next invocation
# picks up exactly where it left off, so nothing is lost to a timeout.
#
# Keep the budget comfortably under the route's maxDuration so the digest still
# has time to write and send.
WORKER_TIME_BUDGET_MS=45000
WORKER_BATCH_SIZE=25

# =============================================================================
# Optional sources and providers
# =============================================================================
# Adzuna — free key at https://developer.adzuna.com/signup (250 calls/day).
# The source is skipped unless BOTH are set. Their terms require the
# "Jobs by Adzuna" credit rendered in the dashboard footer — do not remove it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Claude-written cover letters and pitches instead of the built-in templates.
# Leave unset to use templates — the app works fine without it.
ANTHROPIC_API_KEY=

# How many days an untriaged job stays in your Inbox before it moves to
# Archive. Nothing is deleted and nothing is written when you change this --
# staleness is a read-time comparison, so raising or lowering it reflows every
# bucket instantly and reversibly.
JOB_STALE_DAYS=30

# Max freelance/contract outreach emails auto-sent per day.
OUTREACH_DAILY_CAP=10

# RETIRED, 2026-08-21. Upwork removed its public RSS job feeds — the endpoint
# returns 410 Gone. ENABLE_UPWORK_RSS no longer exists and setting it does
# nothing; the source reports itself as retired in the digest. Remaining
# freelance lead sources: arbeitnow_contract and wwr_contract.

# Your deployed URL, used in the digest email's dashboard link.
NEXT_PUBLIC_APP_URL=
